<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>visual_perception</name>
  <version>1.0.0</version>
  <description>D435 Visual Perception Package for Obstacle Avoidance and Road Segmentation</description>
  <maintainer email="user@todo.todo">suja</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- Image processing -->
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>image_geometry</depend>

  <!-- Point cloud processing -->
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>

  <!-- TF2 -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_sensor_msgs</depend>

  <!-- RealSense camera (optional, for launch files) -->
  <exec_depend>realsense2_camera</exec_depend>

  <!-- Message filters for synchronization -->
  <depend>message_filters</depend>

  <!-- OpenCV -->
  <build_depend>OpenCV</build_depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
